class AdvancedLogger {
    constructor() {
        this.logStream = CONFIG.LOG_TO_FILE ? fs.createWriteStream(CONFIG.LOG_FILE_PATH, { flags: 'a' }) : null;
        this.levels = { DEBUG: 0, INFO: 1, WARN: 2, ERROR: 3, NONE: 4 };
        this.currentLevel = this.levels[CONFIG.LOG_LEVEL] || 1;
    }
    
    _format(level, msg) {
        const timestamp = new Date().toISOString();
        const colors = { DEBUG: '\x1b[36m', INFO: '\x1b[32m', WARN: '\x1b[33m', ERROR: '\x1b[31m' };
        const reset = '\x1b[0m';
        const colored = `${colors[level] || ''}[${timestamp}] [${level}] ${msg}${reset}`;
        const raw = `[${timestamp}] [${level}] ${msg}`;
        return { colored, raw };
    }
    
    log(level, msg) {
        if (this.levels[level] < this.currentLevel) return;
        const { colored, raw } = this._format(level, msg);
        console.log(colored);
        if (this.logStream) this.logStream.write(raw + '\n');
    }
    
    debug(msg) { this.log('DEBUG', msg); }
    info(msg) { this.log('INFO', msg); }
    warn(msg) { this.log('WARN', msg); }
    error(msg) { this.log('ERROR', msg); }
    
    progress(current, total, label = 'Progress') {
        if (!CONFIG.SHOW_PROGRESS_BAR) return;
        const percent = ((current / total) * 100).toFixed(1);
        const barLength = 30;
        const filled = Math.round((current / total) * barLength);
        const bar = '█'.repeat(filled) + '░'.repeat(barLength - filled);
        this.info(`${label} |${bar}| ${current}/${total} (${percent}%)`);
    }
}

