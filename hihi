class MemoryManager {
    constructor(memoryLimitMB = CONFIG.MEMORY_LIMIT_MB) {
        this.limit = memoryLimitMB * 1024 * 1024;
        this.checkInterval = setInterval(() => this.check(), 10000);
    }
    
    check() {
        const usage = process.memoryUsage().rss;
        if (usage > this.limit) {
            logger.warn(`Memory usage ${(usage / 1024 / 1024).toFixed(2)} MB exceeds limit ${this.limit / 1024 / 1024} MB. Forcing GC.`);
            if (global.gc) global.gc();
            else logger.warn('GC not exposed. Run with --expose-gc');
        }
    }
    
    stop() { clearInterval(this.checkInterval); }
}

