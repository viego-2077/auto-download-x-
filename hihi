class RateLimitController {
    constructor(maxConcurrent = CONFIG.MAX_CONCURRENT_API_CALLS) {
        this.max = maxConcurrent;
        this.active = 0;
        this.queue = [];
        this.globalBuffer = CONFIG.GLOBAL_RATE_LIMIT_BUFFER_MS;
        this.lastCall = 0;
    }
    
    async acquire() {
        const now = Date.now();
        const timeSinceLast = now - this.lastCall;
        if (timeSinceLast < this.globalBuffer) {
            await new Promise(r => setTimeout(r, this.globalBuffer - timeSinceLast));
        }
        if (this.active < this.max) {
            this.active++;
            this.lastCall = Date.now();
            return () => { this.active--; this.processQueue(); };
        }
        return new Promise(resolve => {
            this.queue.push(resolve);
        });
    }
    
    processQueue() {
        if (this.queue.length > 0 && this.active < this.max) {
            const resolve = this.queue.shift();
            this.active++;
            this.lastCall = Date.now();
            resolve(() => { this.active--; this.processQueue(); });
        }
    }
}

class ProxyManager {
    constructor() {
        this.proxies = [];
        this.currentIndex = 0;
        this.lastRefresh = 0;
        this.refreshInterval = CONFIG.PROXY_REFRESH_INTERVAL_MS;
        this.loadProxies();
        if (CONFIG.ENABLE_PROXY_ROTATION) this.startAutoRefresh();
    }
    
    loadProxies() {
        if (!CONFIG.ENABLE_PROXY_ROTATION) return;
        try {
            if (fs.existsSync(CONFIG.PROXY_FILE)) {
                const content = fs.readFileSync(CONFIG.PROXY_FILE, 'utf8');
                this.proxies = content.split('\n')
                    .filter(l => l.trim() && l.includes(':'))
                    .map(l => {
                        const [host, port] = l.trim().split(':');
                        return { host, port: parseInt(port) };
                    });
                logger.info(`Loaded ${this.proxies.length} proxies from ${CONFIG.PROXY_FILE}`);
            } else {
                logger.warn(`Proxy file not found: ${CONFIG.PROXY_FILE}`);
            }
        } catch (err) {
            logger.error(`Failed to load proxies: ${err.message}`);
        }
    }
    
    startAutoRefresh() {
        setInterval(() => {
            this.loadProxies();
            this.lastRefresh = Date.now();
        }, this.refreshInterval);
    }
    
    getNextProxy() {
        if (this.proxies.length === 0) return {};
        this.currentIndex = (this.currentIndex + 1) % this.proxies.length;
        const p = this.proxies[this.currentIndex];
        return { proxy: { host: p.host, port: p.port, protocol: 'http' } };
    }
}

