const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

class RateLimiter {
    constructor(maxConcurrent) {
        this.max = maxConcurrent;
        this.current = 0;
        this.queue = [];
    }
    async acquire() {
        if (this.current < this.max) {
            this.current++;
            return () => { this.current--; this.processQueue(); };
        }
        return new Promise(resolve => {
            this.queue.push(resolve);
        });
    }
    processQueue() {
        if (this.queue.length > 0 && this.current < this.max) {
            const resolve = this.queue.shift();
            this.current++;
            resolve(() => { this.current--; this.processQueue(); });
        }
    }
}

class ProxyRotator {
    constructor(proxyFile) {
        this.proxies = [];
        this.currentIndex = 0;
        if (fs.existsSync(proxyFile)) {
            this.proxies = fs.readFileSync(proxyFile, 'utf8')
                .split('\n')
                .filter(l => l.trim() && l.includes(':'))
                .map(l => {
                    const [host, port] = l.split(':');
                    return { host, port: parseInt(port) };
                });
            Logger.info(`Loaded ${this.proxies.length} proxies`);
        } else {
            Logger.warn('No proxy file found, running without proxies');
        }
    }
    getNextProxy() {
        if (this.proxies.length === 0) return {};
        this.currentIndex = (this.currentIndex + 1) % this.proxies.length;
        const p = this.proxies[this.currentIndex];
        return { proxy: { host: p.host, port: p.port } };
    }
}

const proxyRotator = CONFIG.USE_PROXY_ROTATION ? new ProxyRotator(CONFIG.PROXY_FILE) : null;
const rateLimiter = new RateLimiter(CONFIG.MAX_CONCURRENT_REQUESTS);

async function fetchWithRetry(url, options, retries = CONFIG.REQUEST_RETRIES) {
    for (let i = 0; i < retries; i++) {
        try {
            const release = await rateLimiter.acquire();
            const proxy = proxyRotator ? proxyRotator.getNextProxy() : {};
            const response = await axios({ url, ...options, ...proxy, timeout: 10000 });
            release();
            return response;
        } catch (err) {
            Logger.warn(`Retry ${i + 1}/${retries} for ${url}: ${err.message}`);
            await sleep(CONFIG.RETRY_DELAY_MS * (i + 1));
        }
    }
    throw new Error(`Failed after ${retries} retries: ${url}`);
}

